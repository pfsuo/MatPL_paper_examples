mass   1    15.999
mass   2    1.00784
pair_style   matpl/nep/kk /data/home/pfsuo/pfsuo/software/build/nep-data/2023_Xu_liquid_water/nep.txt
NEP Kokkos potential /data/home/pfsuo/pfsuo/software/build/nep-data/2023_Xu_liquid_water/nep.txt loaded successfully
pair_coeff       * * O H

thermo_style    custom step temp pe ke etotal press vol
thermo          ${THERMO_FREQ}
thermo          100

if "${restart} == 0" then "velocity        all create ${TEMP} 35826"
velocity        all create ${TEMP} 35826
velocity        all create 300 35826
fix             1 all nvt/kk temp ${TEMP} ${TEMP} ${TAU_T} #iso ${PRESS} ${PRESS} ${TAU_P}
fix             1 all nvt/kk temp 300 ${TEMP} ${TAU_T} 
fix             1 all nvt/kk temp 300 300 ${TAU_T} 
fix             1 all nvt/kk temp 300 300 0.05 

timestep        0.000500
run             ${NSTEPS} upto
run             10000 upto
